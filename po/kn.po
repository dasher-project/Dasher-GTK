msgid "A crash report was saved to ~/Library/Logs/DiagnosticReports/Dasher-*.ips. If you can share it in a GitHub issue, it helps us fix the bug."
msgstr "ಕ್ರ್ಯಾಶ್ ವರದಿಯನ್ನು ~/Library/Logs/DiagnosticReports/Dasher-*.ips ಗೆ ಉಳಿಸಲಾಗಿದೆ. ನೀವು ಅದನ್ನು GitHub ಸಮಸ್ಯೆಯಲ್ಲಿ ಹಂಚಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಾದರೆ, ಅದು ದೋಷವನ್ನು ಸರಿಪಡಿಸಲು ನಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ."

msgid "About"
msgstr "ಕುರಿತಾಗಿ"

msgid "Dasher {0}"
msgstr "ಡ್ಯಾಶರ್ {0}"

msgid "Accept hover/pointer events as Dasher input. Enable for eye tracking or external pointers."
msgstr "ಡ್ಯಾಷರ್ ಇನ್‌ಪುಟ್ ಆಗಿ ಹೋವರ್/ಪಾಯಿಂಟರ್ ಈವೆಂಟ್‌ಗಳನ್ನು ಸ್ವೀಕರಿಸಿ. ಕಣ್ಣಿನ ಟ್ರ್ಯಾಕಿಂಗ್ ಅಥವಾ ಬಾಹ್ಯ ಪಾಯಿಂಟರ್‌ಗಳಿಗಾಗಿ ಸಕ್ರಿಯಗೊಳಿಸಿ."

msgid "Access"
msgstr "ಪ್ರವೇಶ"

msgid "Accessibility Permission Required"
msgstr "ಪ್ರವೇಶಿಸುವಿಕೆ ಅನುಮತಿ ಅಗತ್ಯವಿದೆ"

msgid "Adapt Speed Automatically"
msgstr "ವೇಗವನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಹೊಂದಿಸಿ"

msgid "Advanced logging"
msgstr "ಅદ્યತಮಾನ ಲಾಗಿಂಗ್"

msgid "Detailed diagnostic logging for bug reports (per-sample eye-tracker lines, keystroke traces, UIA reads). Basic connection events are always logged. May generate large log files."
msgstr "ಬಗ್ ವರದಿಗಳಿಗಾಗಿ ವಿವರವಾದ ನಿರ್ಣಯ ದಾಖಲಾತಿ (ಪ್ರತಿ ನમೂನಾ ಐ ಟ್ರ್ಯಾಕರ್ ಸಾಲುಗಳು, ಕೀಲಿಹಿಡಿತ ಟ್ರೇಸ್‌ಗಳು, UIA ಓದಿರುವುದು). ಮೂಲಭೂತ ಸಂಪರ್ಕ ಘಟನೆಗಳು ಸದಾ ದಾಖಲಿಸಲಾಗುತ್ತವೆ. ದೊಡ್ಡ ಲಾಗ್ ಕಡತಗಳನ್ನು ರಚಿಸಬಹುದು."

msgid "Advanced settings"
msgstr "ಸುಧಾರಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "All Dasher settings will be restored to their default values. This cannot be undone."
msgstr "ಎಲ್ಲಾ ಡ್ಯಾಷರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅವುಗಳ ಡೀಫಾಲ್ಟ್ ಮೌಲ್ಯಗಳಿಗೆ ಮರುಸ್ಥಾಪಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ."

msgid "Alphabet"
msgstr "ವರ್ಣಮಾಲೆ"

msgid "Help improve Dasher"
msgstr "ಡ್ಯಾಷರ್ ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿ"

msgid "Share anonymous usage analytics and crash reports? No typed text, clipboard contents or personal information is ever collected. You can change this any time in Settings."
msgstr "ಗೋಪ್ಯ ಬಳಕೆ ವಿಶ್ಲೇಷಣೆಗಳು ಮತ್ತು ಕ್ರ್ಯಾಷ್ ವರದಿಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಬೇಡಾ? ಯಾವುದೇ ಟೈಪ್ ಮಾಡಿದ ಪಠ್ಯ, ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ವಿಷಯಗಳು ಅಥವಾ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ. ನೀವು ಇದನ್ನು ಯಾವಾಗಲಾದರೂ ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಲ್ಲಿ ಬದಲಾಯಿಸಬಹುದು."

msgid "Not now"
msgstr "ಈಗಲ್ಲ"

msgid "Share anonymous analytics and crash reports"
msgstr "ಅನಾಮಧೇಯ ವಿಶ್ಲೇಷಣೆಗಳು ಮತ್ತು ಕ್ರ್ಯಾಶ್ ವರದಿಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ"

msgid "Dasher collects anonymous, privacy-respecting analytics to understand usage patterns and fix crashes. No typed text, clipboard contents, or personal information is ever collected.\n\nYou can change this anytime in Settings > Privacy."
msgstr "ಡ್ಯಾಷರ್ ಬಳಕೆದಾರ ಹಬ್ಬಿಸುವ ಮಾದರಿಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಮತ್ತು ಕ್ರ್ಯಾಶ್‌ಗಳನ್ನು ಸರಿಹೊಂದಿಸಲು ಗೌಪ್ಯತೆಯನ್ನು ಗೌರವಿಸುವ ಅನಾಮಧೇಯ ವಿಶ್ಲೇಷಣೆಯನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ. ಯಾವುದೇ ಟೈಪ್ ಮಾಡಲಾದ ಪಠ್ಯ, ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ವಿಷಯಗಳು ಅಥವಾ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಎಂದಿಗೂ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ.\n\nನೀವು ಇದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು > ಗೌಪ್ಯತೆ ನಲ್ಲಿ ಬದಲಾಯಿಸಬಹುದು."

msgid "Reset analytics ID"
msgstr "ಅನಾಲಿಟಿಕ್ಸ್ ಐಡಿಯನ್ನು ಮರುಹೊಂದಿಸಿ"

msgid "Dasher collects anonymous usage analytics and crash reports to understand how the app is used and to fix bugs. No typed text, clipboard contents, or personal information is ever collected."
msgstr "ಡ್ಯಾಶರ್ ಅಪ್ಲಿಕೇಶನ್ ಹೇಗೆ ಬಳಸಲಾಗುತ್ತದೆ ಮತ್ತು ದೋಷಗಳನ್ನು ಸರಿಪಡಿಸಲು ಗುರಿಯಾಗಿರುವ ಅನಾಮಧೇಯ ಬಳಕೆ ವಿಶ್ಲೇಷಣೆ ಮತ್ತು ಕ್ರ್ಯಾಶ್ ವರಿದಾಂಶಗಳನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ. ಯಾವುದೇ ಟೈಪ್ ಮಾಡಿದ ಪಠ್ಯ, ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ವಿಷಯಗಳು ಅಥವಾ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಎಂದಿಗೂ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ."

msgid "Help improve Dasher?"
msgstr "ಡ್ಯಾಶರ್ ಅನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಲಾಗುವುದು?"

msgid "Anonymous ID: {0}"
msgstr "ಅನಾಮಿಕ ಐಡಿ: {0}"

msgid "Anonymous usage analytics"
msgstr "ಅನಾಮಧೇಯ ಬಳಕೆಯ ವಿಶ್ಲೇಷಣೆ"

msgid "Anonymous usage analytics help us understand how Dasher is used and fix crashes. No typed text, clipboard contents, or personal information is ever collected. Opt out any time in Settings → Privacy."
msgstr "ಅನಾಮಧೇಯ ಬಳಕೆಯ ವಿಶ್ಲೇಷಣೆಯು ಡ್ಯಾಷರ್ ಅನ್ನು ಹೇಗೆ ಬಳಸಲಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಮತ್ತು ಕ್ರ್ಯಾಶ್‌ಗಳನ್ನು ಸರಿಪಡಿಸಲು ನಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಟೈಪ್ ಮಾಡಿದ ಪಠ್ಯ, ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ವಿಷಯಗಳು ಅಥವಾ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಎಂದಿಗೂ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ. ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಗೌಪ್ಯತೆಯಲ್ಲಿ ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಆಯ್ಕೆಯಿಂದ ಹೊರಗುಳಿಯಿರಿ."

