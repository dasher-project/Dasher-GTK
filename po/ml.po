msgid "%1$.1f cps · %2$d wpm"
msgstr "%1$.1f സിപിഎസ് · %2$d വാക്കുകൾ മിനിറ്റിൽ"

msgid "A crash report was saved to ~/Library/Logs/DiagnosticReports/Dasher-*.ips. If you can share it in a GitHub issue, it helps us fix the bug."
msgstr "ഒരു ക്രാഷ് റിപ്പോർട്ട് ~/Library/Logs/DiagnosticReports/Dasher-*.ips-ൽ സേവ് ചെയ്‌തു. ഒരു GitHub പ്രശ്‌നത്തിൽ നിങ്ങൾക്ക് ഇത് പങ്കിടാൻ കഴിയുമെങ്കിൽ, ബഗ് പരിഹരിക്കാൻ അത് ഞങ്ങളെ സഹായിക്കും."

msgid "About"
msgstr "കുറിച്ച്"

msgid "Dasher {0}"
msgstr "ഡാഷർ {0}"

msgid "Accept hover/pointer events as Dasher input. Enable for eye tracking or external pointers."
msgstr "ഡാഷർ ഇൻപുട്ടായി ഹോവർ/പോയിന്റർ ഇവന്റുകൾ സ്വീകരിക്കുക. ഐ ട്രാക്കിംഗ് അല്ലെങ്കിൽ ബാഹ്യ പോയിന്ററുകൾക്കായി പ്രവർത്തനക്ഷമമാക്കുക."

msgid "Access"
msgstr "ആക്സസ്"

msgid "Accessibility Permission Required"
msgstr "പ്രവേശനക്ഷമത അനുമതി ആവശ്യമാണ്"

msgid "Adapt Speed Automatically"
msgstr "വേഗത യാന്ത്രികമായി ക്രമീകരിക്കുക"

msgid "Advanced logging"
msgstr "മേന്മയുള്ള ലോഗിംഗ്"

msgid "Detailed diagnostic logging for bug reports (per-sample eye-tracker lines, keystroke traces, UIA reads). Basic connection events are always logged. May generate large log files."
msgstr "ബഗ് റിപ്പോർട്ടുകൾക്കായി വിശദമായ ഡയഗ്നോസ്റിക് ലോഗ്ഗിംഗ് (പ്രതി-സാമ്പിൾ ഐ ട്രാക്കർ വരികൾ, കീസ്ട്രോക്ക് ട്രേസുകൾ, UIA വായനകൾ). അടിസ്ഥാന കണക്ഷൻ ഇവന്റുകൾ എല്ലായ്പ്പോഴും ലോഗ് ചെയ്യപ്പെടുന്നു. വലിയ ലോഗ് ഫയലുകൾ സൃഷ്ടിക്കാൻ സാധ്യതയുണ്ട്."

msgid "Advanced settings"
msgstr "വിപുലമായ ക്രമീകരണങ്ങൾ"

msgid "All Dasher settings will be restored to their default values. This cannot be undone."
msgstr "എല്ലാ ഡാഷർ ക്രമീകരണങ്ങളും അവയുടെ സ്ഥിര മൂല്യങ്ങളിലേക്ക് പുനഃസ്ഥാപിക്കപ്പെടും. ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല."

msgid "Alphabet"
msgstr "അക്ഷരമാല"

msgid "Help improve Dasher"
msgstr "ഡാഷർ മെച്ചപ്പെടുത്താൻ സഹായിക്കുക"

msgid "Share anonymous usage analytics and crash reports? No typed text, clipboard contents or personal information is ever collected. You can change this any time in Settings."
msgstr "അജ്ഞാത ഉപയോഗ വിശകലനങ്ങളും തകരാർ റിപ്പോർട്ടുകളും പങ്കിടണോ? ടൈപ്പ് ചെയ്ത ടെക്സ്റ്റ്, ക്ലിപ്പ്ബോർഡ് ഉള്ളടക്കം അല്ലെങ്കിൽ വ്യക്തിഗത വിവരങ്ങൾ ഒരിക്കലും ശേഖരിക്കില്ല. ഇത് ഏത് സമയത്തും ക്രമീകരണങ്ങളിൽ മാറ്റാം."

msgid "Not now"
msgstr "ഇപ്പോൾ വേണ്ട"

msgid "Share anonymous analytics and crash reports"
msgstr "അജ്ഞാത വിശകലനങ്ങളും ക്രാഷ് റിപ്പോർട്ടുകളും പങ്കിടുക"

msgid "Dasher collects anonymous, privacy-respecting analytics to understand usage patterns and fix crashes. No typed text, clipboard contents, or personal information is ever collected.\n\nYou can change this anytime in Settings > Privacy."
msgstr "Dasher അജ്ഞാത, സ്വകാര്യത മാനിക്കുന്ന വിശകലനങ്ങൾ ശേഖരിക്കുന്നു ഉപയോഗ മാതൃകകൾ മനസ്സിലാക്കാനും തകരാറുകൾ പരിഹരിക്കാനും. ടൈപ്പ് ചെയ്ത ടെക്സ്റ്റ്, ക്ലിപ്പ്ബോർഡ് ഉള്ളടക്കം, അല്ലെങ്കിൽ വ്യക്തിഗത വിവരങ്ങൾ ഒരിക്കലും ശേഖരിക്കില്ല.\n\nഇത് ഏത് സമയത്തും ക്രമീകരണങ്ങൾ > സ്വകാര്യതയിൽ മാറ്റാം."

msgid "Reset analytics ID"
msgstr "അനലിറ്റിക്സ് ഐഡി പുനഃസജ്ജമാക്കുക"

msgid "Dasher collects anonymous usage analytics and crash reports to understand how the app is used and to fix bugs. No typed text, clipboard contents, or personal information is ever collected."
msgstr "Dasher അജ്ഞാത ഉപയോഗ വിശകലനങ്ങളും തകരാർ റിപ്പോർട്ടുകളും ശേഖരിക്കുന്നു ആപ്പ് എങ്ങനെ ഉപയോഗിക്കപ്പെടുന്നു എന്ന് മനസ്സിലാക്കാനും ബഗുകൾ പരിഹരിക്കാനും. ടൈപ്പ് ചെയ്ത ടെക്സ്റ്റ്, ക്ലിപ്പ്ബോർഡ് ഉള്ളടക്കം, അല്ലെങ്കിൽ വ്യക്തിഗത വിവരങ്ങൾ ഒരിക്കലും ശേഖരിക്കില്ല."

msgid "Help improve Dasher?"
msgstr "ഡാഷറെ മെച്ചപ്പെടുത്താൻ സഹായിക്കാമോ?"

msgid "Anonymous ID: {0}"
msgstr "അജ്ഞാത ഐഡി: {0}"

msgid "Anonymous usage analytics"
msgstr "അജ്ഞാത ഉപയോഗ അനലിറ്റിക്സ്"

msgid "Anonymous usage analytics help us understand how Dasher is used and fix crashes. No typed text, clipboard contents, or personal information is ever collected. Opt out any time in Settings → Privacy."
msgstr "ഡാഷർ എങ്ങനെയാണ് ഉപയോഗിക്കുന്നതെന്ന് മനസ്സിലാക്കാനും ക്രാഷുകൾ പരിഹരിക്കാനും അജ്ഞാത ഉപയോഗ വിശകലനം ഞങ്ങളെ സഹായിക്കുന്നു. ടൈപ്പ് ചെയ്ത ടെക്‌സ്‌റ്റ്, ക്ലിപ്പ്ബോർഡ് ഉള്ളടക്കങ്ങൾ അല്ലെങ്കിൽ വ്യക്തിഗത വിവരങ്ങൾ ഒരിക്കലും ശേഖരിക്കില്ല. ക്രമീകരണങ്ങൾ → സ്വകാര്യതയിൽ എപ്പോൾ വേണമെങ്കിലും ഒഴിവാക്കുക."

